#!/bin/bash
set -Eeuo pipefail

ROOT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT_DIR"

if [[ -f .env ]]; then
  set -a
  source .env
  set +a
fi

BACKEND_PORT="${BACKEND_PORT:-8000}"
FRONTEND_PORT="${FRONTEND_PORT:-3000}"
HOST="${HOST:-127.0.0.1}"
FRONTEND_DIR="${FRONTEND_DIR:-frontend}"
LOG_DIR="${LOG_DIR:-logs}"
AUTO_INSTALL="${AUTO_INSTALL:-1}"

mkdir -p "$LOG_DIR"

case "${1:-start}" in
  stop)
    for name in backend frontend startup; do
      file="$LOG_DIR/$name.pid"
      if [[ -f "$file" ]]; then
        pid="$(cat "$file")"
        kill "$pid" 2>/dev/null || true
        rm -f "$file"
      fi
    done
    echo "Stop signal sent."
    exit 0
    ;;
  status)
    for name in startup backend frontend; do
      file="$LOG_DIR/$name.pid"
      if [[ -f "$file" ]] && kill -0 "$(cat "$file")" 2>/dev/null; then
        echo "$name: running (PID $(cat "$file"))"
      else
        echo "$name: not running"
      fi
    done
    exit 0
    ;;
  logs)
    tail -n 80 -f "$LOG_DIR/startup.log" "$LOG_DIR/backend.log" "$LOG_DIR/frontend.log"
    exit 0
    ;;
  start) ;;
  *)
    echo "Usage: ./run [start|stop|status|logs]"
    exit 2
    ;;
esac

if [[ -f "$LOG_DIR/startup.pid" ]] && kill -0 "$(cat "$LOG_DIR/startup.pid")" 2>/dev/null; then
  echo "Startup already running. Try: ./run status"
  exit 0
fi

ROOT_DIR="$ROOT_DIR" LOG_DIR="$LOG_DIR" AUTO_INSTALL="$AUTO_INSTALL" \
BACKEND_PORT="$BACKEND_PORT" FRONTEND_PORT="$FRONTEND_PORT" \
HOST="$HOST" FRONTEND_DIR="$FRONTEND_DIR" \
nohup bash -c '
set -Eeuo pipefail
cd "$ROOT_DIR"
mkdir -p "$LOG_DIR"
exec >> "$LOG_DIR/startup.log" 2>&1

echo "===== Startup: $(date) ====="

if [[ ! -x .venv/bin/python ]]; then
  if [[ "$AUTO_INSTALL" != "1" ]]; then
    echo "Missing .venv; set AUTO_INSTALL=1 in .env"
    exit 1
  fi
  echo "Installing dependencies..."
  bash install-macos.sh
fi

PYTHON="$ROOT_DIR/.venv/bin/python"
if [[ ! -x "$PYTHON" ]]; then
  echo "ERROR: .venv/bin/python was not created."
  exit 1
fi

echo "Checking backend runtime dependencies..."
"$PYTHON" -m pip install "uvicorn[standard]==0.23.2" websockets
"$PYTHON" -m pip install --upgrade yt-dlp

echo "Building frontend..."
cd "$ROOT_DIR/$FRONTEND_DIR"
npm install
npm run build
cd "$ROOT_DIR"

nohup "$PYTHON" -m uvicorn backend.mse.api.api:app \
  --host "$HOST" --port "$BACKEND_PORT" \
  >> "$ROOT_DIR/$LOG_DIR/backend.log" 2>&1 &
echo $! > "$ROOT_DIR/$LOG_DIR/backend.pid"

nohup npm --prefix "$ROOT_DIR/$FRONTEND_DIR" run preview -- \
  --host "$HOST" --port "$FRONTEND_PORT" \
  >> "$ROOT_DIR/$LOG_DIR/frontend.log" 2>&1 &
echo $! > "$ROOT_DIR/$LOG_DIR/frontend.pid"

echo "Startup commands launched."
echo "Frontend: http://localhost:$FRONTEND_PORT"
echo "Backend: http://localhost:$BACKEND_PORT"
' >/dev/null 2>&1 &

echo $! > "$LOG_DIR/startup.pid"
echo "Background startup launched."
echo "Follow progress: ./run logs"
